{
  "name": "nova-ai-console",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "npm@11.8.0",
  "workspaces": [
    "packages/*",
    "distributions/base",
    "distributions/nova-ai"
  ],
  "scripts": {
    "dev": "npm run start:dev --workspace @nova-ai/console",
    "start:dev": "npm run start:dev --workspace @nova-ai/console",
    "build": "npm run build --workspace @nova-ai/console",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "type-check": "turbo run type-check",
    "test-unit": "turbo run test-unit",
    "test-unit-coverage": "turbo run test-unit-coverage",
    "format": "prettier --write \"distributions/**/*.{ts,tsx}\" \"packages/**/*.{ts,tsx}\""
  },
  "devDependencies": {
    "@nova-ai/eslint-config": "*",
    "@types/node": "^22.19.19",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "csstype": "^3.2.3",
    "eslint": "^8.57.1",
    "rimraf": "^6.1.2",
    "turbo": "^2.9.16",
    "typescript": "^5.9.3",
    "webpack": "5.104.1"
  },
  "overrides": {
    "@types/react": "^18.3.31",
    "csstype": "^3.2.3",
    "react-router": "^7.17.0",
    "webpack": "5.104.1"
  }
}
