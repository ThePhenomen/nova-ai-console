STARVAULT_OIDC_ISSUER=https://starvault.example.com/v1/identity/oidc/provider/nova
STARVAULT_OIDC_CLIENT_ID=
STARVAULT_OIDC_CLIENT_SECRET=
STARVAULT_OIDC_SCOPES=openid email profile groups
STARVAULT_OIDC_REDIRECT_URI=http://127.0.0.1:4020/auth/callback

# Base64 of a kubeconfig with a token or client certificate.
# The API server accepts ID tokens only for its --oidc-client-id
# (oidc-kubernetes-client, the client nova-console uses). This console logs in
# with its own client, so the proxy impersonates that same Kubernetes user:
# username claim sub, groups claim groups. The kubeconfig identity must be
# allowed to impersonate users and groups.
#   printf '%s' "$(cat ~/.kube/config)" | base64
KUBECONFIG_BASE64=

# OpenShift / Nova Console used to create MLCluster in a project.
NOVA_CONSOLE_URL=https://nova-console.example.com
