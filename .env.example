STARVAULT_OIDC_ISSUER=https://starvault.example.com/v1/identity/oidc/provider/nova
STARVAULT_OIDC_CLIENT_ID=
STARVAULT_OIDC_CLIENT_SECRET=
STARVAULT_OIDC_SCOPES=openid name email
STARVAULT_OIDC_REDIRECT_URI=http://127.0.0.1:4020/auth/callback

# Base64 of a kubeconfig with a token or client-certificate-data + client-key-data.
# Credentials stay on the webpack proxy; the browser only sees the API server URL.
#   printf '%s' "$(cat ~/.kube/config)" | base64
KUBECONFIG_BASE64=
